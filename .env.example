# Leave empty until you are ready to make real model calls.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90

# New installations use clearly labelled mock output. The browser can change the active provider.
AI_PROVIDER=mock
LAB_DATA_DIR=data
# Use 0.0.0.0 for IPv4 LAN access. Override with: ./scripts/dev.sh --host 0.0.0.0
LAB_HOST=127.0.0.1
LAB_PORT=8765
